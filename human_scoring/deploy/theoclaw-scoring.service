[Unit]
Description=TheoClaw 線上人工評分（含提問模式，預設 deepseek-flash）
After=network-online.target mysql.service

[Service]
User=theoclaw
WorkingDirectory=/opt/theoclaw
# 平信徒每人每天 10 題；牧者每人每天 15 篇講章。團體合計不設上限（--group-daily-limit 0），
# 總花費實際上也不設上限（--budget 100000）：真正的上限是 DeepSeek 帳戶的餘額，只充少量即可。
# 要改上限就改下面這一行，再 systemctl restart theoclaw-scoring
# 資料存 MySQL（.env 的 THEOCLAW_DB；沒有這一行就用 runs/pastor-chat/theoclaw.db 這個 SQLite 檔）
ExecStart=/opt/theoclaw/.venv/bin/python human_scoring/human_server.py serve --chat --host 127.0.0.1 --port 8765 --daily-limit 10 --group-daily-limit 0 --sermon-daily-limit 15 --budget 100000 --storage db
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
