[Unit]
Description=TheoClaw 資料庫版（測試用，MySQL；與正式的檔案版分開）
After=network-online.target mysql.service

[Service]
User=theoclaw
WorkingDirectory=/opt/theoclaw
# 與正式服務相同的上限，只是資料存 MySQL（.env 的 THEOCLAW_DB）、聽 8766 埠。
# 啟動時會把檔案版還沒進資料庫的資料匯入（不重複），所以測試時看得到正式版的歷史紀錄。
ExecStart=/opt/theoclaw/.venv/bin/python human_scoring/human_server.py serve --chat --storage db --host 127.0.0.1 --port 8766 --daily-limit 20 --group-daily-limit 200 --sermon-daily-limit 15 --budget 5
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
